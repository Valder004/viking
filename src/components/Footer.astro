---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p>© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.875rem;
    padding-block: 1.5rem;
  }
  .footer p {
    margin: 0;
  }
</style>
